FROM node:22-alpine AS dependencies
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
FROM node:22-alpine
ENV NODE_ENV=production APP_MODE=public PORT=10000 COOKIE_SECURE=true TRUST_PROXY=true
WORKDIR /app
COPY --from=dependencies --chown=node:node /build/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node app/server ./app/server
COPY --chown=node:node app/public ./app/public
COPY --chown=node:node infra/sql/public.sql ./infra/sql/public.sql
USER node
EXPOSE 10000
CMD ["node","app/server/index.js"]
